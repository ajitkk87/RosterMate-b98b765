# Server Configuration
PORT=3000

# Database Configuration
# For local MongoDB: mongodb://localhost:27017/rostermate
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/rostermate
DATABASE_URL=mongodb://localhost:27017/rostermate

# JWT Secrets (CHANGE THESE IN PRODUCTION!)
# Generate strong secrets using: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production

# Session Secret (CHANGE THIS IN PRODUCTION!)
SESSION_SECRET=your-session-secret-change-this-in-production

# Optional: Node Environment
# NODE_ENV=development
